# =============================================================================
# MUON marketing site (root Next.js app), environment variables
# =============================================================================
# The marketing/waitlist site is deployed on VERCEL. The values below marked
# "DEPLOYED" are what the live Vercel frontend needs. NEVER use localhost in any
# deployed environment.

# -----------------------------------------------------------------------------
# DEPLOYED (Vercel), waitlist store
# -----------------------------------------------------------------------------
# The waitlist + enterprise-contact API routes write to Railway Postgres using a
# dedicated, least-privilege role (`waitlist_writer`), NOT the Postgres
# superuser and NOT the MUON backend's embedded SQLite brain. Server-side only
# (no NEXT_PUBLIC_ prefix), so it is never exposed to the browser.
# Format: postgresql://waitlist_writer:<password>@<railway-tcp-proxy-host>:<port>/railway
#
# Tables:
#   - waitlist (early-access form)
#   - "EnterpriseContact" (enterprise form; shape owned by
#     backend/prisma/schema.prisma model EnterpriseContact)
#
# One-time Railway DDL for the enterprise table (Postgres):
#   CREATE TABLE "EnterpriseContact" (
#     "id" TEXT PRIMARY KEY,
#     "fullName" TEXT NOT NULL,
#     "role" TEXT NOT NULL,
#     "company" TEXT NOT NULL,
#     "companyEmail" TEXT NOT NULL,
#     "phoneNumber" TEXT,
#     "problemDescription" TEXT NOT NULL,
#     "source" TEXT NOT NULL DEFAULT 'marketing_site',
#     "status" TEXT NOT NULL DEFAULT 'new',
#     "createdAt" TIMESTAMPTZ NOT NULL DEFAULT NOW(),
#     "updatedAt" TIMESTAMPTZ NOT NULL DEFAULT NOW()
#   );
#   CREATE INDEX "EnterpriseContact_companyEmail_idx" ON "EnterpriseContact"("companyEmail");
#   CREATE INDEX "EnterpriseContact_createdAt_idx" ON "EnterpriseContact"("createdAt");
#   CREATE INDEX "EnterpriseContact_status_createdAt_idx" ON "EnterpriseContact"("status", "createdAt");
#   GRANT INSERT ON TABLE "EnterpriseContact" TO waitlist_writer;
WAITLIST_DATABASE_URL=postgresql://waitlist_writer:your-password@your-host.proxy.rlwy.net:PORT/railway

# -----------------------------------------------------------------------------
# DEPLOYED (Vercel), MUON backend public URL (Railway)
# -----------------------------------------------------------------------------
# The marketing site is standalone and does not currently call the MUON backend,
# but this points at the real deployed Railway backend (never localhost) for any
# future client-side use. Exposed to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_MUON_API_BASE=https://backend-production-9b7a.up.railway.app

# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY (dev-only, do NOT set these in Vercel)
# -----------------------------------------------------------------------------
# For running the MUON backend locally alongside the site. The deployed frontend
# does NOT use these. localhost values are for local dev exclusively.
# NEXT_PUBLIC_MUON_API_BASE=http://localhost:4000
# MUON_API_BASE=http://localhost:4000
# MUON_API_TOKEN=your-secret-token-min-8-chars
# Optional runtime override. New governed task worktrees default to
# <MUON_DATA_DIR>/worktrees and MUST resolve outside the source repository.
# MUON_WORKTREE_ROOT=/absolute/path/outside/your/repositories
# For local waitlist testing you can point WAITLIST_DATABASE_URL at a local
# Postgres, e.g. postgresql://postgres:postgres@localhost:5432/postgres
