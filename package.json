{
  "name": "muon",
  "version": "0.2.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "next dev -p 3050",
    "build": "next build",
    "start": "next start -p ${PORT:-3050}",
    "lint": "eslint",
    "check:lockfile": "node scripts/check-lockfile-contract.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "benchmark:safety": "node scripts/agent-safety-benchmark.mjs",
    "perf:flood": "node scripts/pty-flood-profiler.mjs",
    "perf:memory": "node scripts/memory-bench.mjs",
    "perf:all": "npm run perf:flood && npm run perf:memory",
    "test": "vitest run",
    "check:docs": "node scripts/check-docs.mjs",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "e2e": "bash scripts/e2e-smoke.sh",
    "upgrade:safety": "bash scripts/upgrade-safety.sh",
    "smoke:mission": "node scripts/mission-smoke.mjs",
    "cli:dev": "npm run --prefix apps/cli dev --",
    "cli:build": "npm run --prefix apps/cli build",
    "release:pipeline": "node scripts/release-pipeline.mjs",
    "cli:test": "npm run --prefix apps/cli test",
    "cli": "npm run --prefix apps/cli start --",
    "tui:dev": "npm run --prefix apps/tui dev --",
    "tui": "npm run --prefix apps/tui build && npm run --prefix apps/tui start --",
    "client:build": "npm run --prefix packages/client build",
    "client:test": "npm run --prefix packages/client test",
    "graph:build": "npm run --prefix packages/graph build",
    "graph:test": "npm run --prefix packages/graph test",
    "codegraph:build": "npm run --prefix packages/codegraph build",
    "codegraph:test": "npm run --prefix packages/codegraph test",
    "mcp:build": "npm run --prefix packages/mcp build",
    "mcp:test": "npm run --prefix packages/mcp test",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "dev:desktop:fresh": "node scripts/dev-desktop.mjs --fresh",
    "dev:desktop:fast": "node scripts/dev-desktop.mjs --fast",
    "dev:desktop:debug": "node scripts/dev-desktop.mjs --debug",
    "debug:report": "node scripts/debug-report.mjs",
    "health:memory": "node scripts/memory-index-health.mjs",
    "backfill:anchors": "node scripts/memory-anchor-backfill.mjs",
    "test:surfaces": "npm run --prefix apps/desktop test && npm run --prefix apps/desktop typecheck && npm run --prefix apps/tui test && npm run --prefix apps/tui typecheck",
    "protocol:build": "npm run --prefix packages/protocol build",
    "adapters:build": "npm run --prefix packages/adapters build",
    "core:build": "npm run --prefix packages/core build",
    "protocol:test": "npm run --prefix packages/protocol typecheck",
    "adapters:test": "npm run --prefix packages/adapters test",
    "core:test": "npm run --prefix packages/core test",
    "tui:legacy": "npm run --prefix apps/tui build && npm run --prefix apps/tui start:classic --",
    "tui:legacy:dev": "npm run --prefix apps/tui dev:classic --",
    "tui:ink": "npm run --prefix apps/tui build && npm run --prefix apps/tui start:ink --"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-slot": "^1.3.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "mermaid": "^11.16.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.19"
    }
  }
}
