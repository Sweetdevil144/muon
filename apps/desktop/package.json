{
  "name": "@muon/desktop",
  "version": "0.3.1",
  "private": true,
  "description": "MUON desktop, crew HQ: chat with the super-orchestrator, size the fleet, watch agents, decide gates",
  "author": "MUON Labs",
  "homepage": "https://getmuon.com",
  "main": "dist/main.js",
  "scripts": {
    "build:icon": "node scripts/sync-app-icon.mjs",
    "check:icon": "node scripts/sync-app-icon.mjs --check",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "esbuild src/renderer/index.tsx --bundle --outfile=dist/renderer/app.js --format=iife --jsx=automatic --loader:.tsx=tsx --platform=browser --target=es2022 && cp src/renderer/index.html src/renderer/styles.css dist/renderer/ && cp node_modules/@xterm/xterm/css/xterm.css dist/renderer/xterm.css && mkdir -p dist/renderer/assets && cp -R src/renderer/assets/. dist/renderer/assets/",
    "build": "npm run build:icon && npm run build:main && npm run build:renderer",
    "start": "electron .",
    "ensure-electron": "node scripts/ensure-electron.mjs",
    "smoke:packaged-runner": "node scripts/smoke-packaged-runner.mjs",
    "smoke:packaged-desktop": "node scripts/smoke-packaged-desktop.mjs",
    "verify:release-artifacts": "node scripts/verify-release-artifacts.mjs",
    "postinstall": "node scripts/ensure-electron.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json",
    "stage-backend": "node scripts/stage-backend.mjs",
    "package:dir": "npm run build && npm run stage-backend && node scripts/write-build-config.mjs && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64",
    "package": "npm run build && npm run stage-backend && node scripts/write-build-config.mjs && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never"
  },
  "dependencies": {
    "@lobehub/icons": "^5.14.0",
    "@muon/adapters": "file:../../packages/adapters",
    "@muon/client": "file:../../packages/client",
    "@muon/core": "file:../../packages/core",
    "@muon/orchestrator": "file:../../packages/orchestrator",
    "@muon/runner": "file:../../packages/runner",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-slot": "^1.3.3",
    "@sigma/edge-curve": "^3.1.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-layout-noverlap": "^0.4.2",
    "lucide-react": "^1.31.0",
    "node-pty": "^1.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sigma": "^3.0.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^39.8.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "electron@39.8.5": true,
    "esbuild@0.25.12": true,
    "@muon/orchestrator@0.1.0": true
  }
}
