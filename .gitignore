# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/backend/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
/backend/.env*
!.env.example
!/backend/.env.example

# build artifacts (regenerated by `npm run build`; never committed)
/backend/dist/
/apps/cli/dist/
/apps/tui/dist/
/apps/desktop/dist/
/packages/*/dist/

# npm-link bin shims (created by `npm link --prefix apps/cli` / packages/mcp)
/apps/cli/bin/
/packages/mcp/bin/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# muon local run artifacts (isolated worktrees)
.muon/

# vendor run-scoped config a test may write into a package dir when it calls
# runTask without a temp cwd (production always writes into the governed
# worktree). Never a real source file under a package.
/packages/*/.cursor/
/packages/*/.opencode/

# swe-bench harness run artifacts (reports are regenerated per run; never committed)
/scripts/swe-bench/reports/

# desktop packaging artifacts (electron-builder output, never commit; ~100s of MB)
/apps/desktop/release/
/apps/desktop/staged/
/apps/desktop/out/
*.dmg
*.blockmap


# prompts
system_prompts/
docs/competitive/

#pvt
PLAN.md
# release pipeline staging dir
.release-stage/
.env

# Third-party agent skills installed by a vendor wizard into this repo's
# .claude/ directory. They are not MUON code, and their references link to the
# vendor's hosted docs, which fails `npm run check:docs` (70 broken links when
# they were accidentally tracked). MUON's OWN skills stay tracked.
.claude/skills/mcp-analytics/
.claude/skills/data-warehouse-source-setup/
